[Unit]
Description=Fangfrisch virus signature updater for SpamTagger
After=network.target
PartOf=spamtagger.target

[Service]
User=clamav
Group=spamtagger
ExecStart=
ExecStart=/usr/bin/fangfrisch -c /usr/spamtagger/tmp/etc/clamav/fangfrisch.conf refresh
ExecStartPre=/usr/spamtagger/bin/dump_fangfrisch.pl

[Install]
WantedBy=spamtagger.target
